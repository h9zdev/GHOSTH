<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#00FFF2" />
            <corners android:radius="3dp" />
            <stroke
                android:width="2dp"
                android:color="#FF1F8F" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0E15" />
            <corners android:radius="3dp" />
            <stroke
                android:width="1.5dp"
                android:color="#00FFF2" />
            <padding
                android:left="10dp"
                android:top="6dp"
                android:right="10dp"
                android:bottom="6dp" />
        </shape>
    </item>
</selector>

