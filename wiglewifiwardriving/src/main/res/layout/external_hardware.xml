<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="// EXTERNAL RADIO HARDWARE &amp; SENSORS"
            android:textColor="@color/cyber_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <!-- Stealth Passive Mode Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/cyber_minimal_bg"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSIVE MONITOR ONLY"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Silent stealth sniffing (blocks active Wi-Fi broadcast probes)"
                    android:textColor="@color/cyber_dim_cyan"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_passive_capture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- NodeMCU GhostH Sniffer & ALPR Detector Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cyber_minimal_bg"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_device_iot"
                    android:contentDescription="NodeMCU GhostH" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="NODEMCU GHOSTH COMPANION"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/nodemcu_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCONNECTED"
                    android:textColor="@color/cyber_pink"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promiscuous 802.11 sniffer + optical Flock ALPR pulse discriminator (25-65Hz). Connect via USB-OTG serial or Wi-Fi AP 'GhostH'."
                android:textColor="@color/cyber_dim_cyan"
                android:textSize="11sp"
                android:paddingTop="3dp" />

            <TextView
                android:id="@+id/nodemcu_packet_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Packets Ingested: 0"
                android:textColor="@color/cyber_yellow"
                android:textSize="11sp"
                android:paddingTop="2dp" />

            <!-- USB Scan & Connect Button -->
            <Button
                android:id="@+id/btn_scan_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="SCAN &amp; CONNECT USB SERIAL (OTG)"
                android:textColor="@color/cyber_cyan"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- GhostH Wi-Fi Connect Button -->
            <Button
                android:id="@+id/btn_connect_ghosth_wifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="CONNECT GHOSTH WI-FI (192.168.4.1:8888)"
                android:textColor="@color/cyber_cyan"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Web Portal Button to Change Password / SSID -->
            <Button
                android:id="@+id/btn_open_ghosth_portal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="OPEN WEB CONFIG (CHANGE PASSWORD / SSID)"
                android:textColor="@color/cyber_yellow"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- ESP32 Promiscuous Sniffer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cyber_minimal_bg"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_device_iot"
                    android:contentDescription="ESP32" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="ESP32 BLUETOOTH SPP"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/esp32_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCONNECTED"
                    android:textColor="@color/cyber_pink"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingests raw beacon &amp; probe request frames streamed over Bluetooth SPP."
                android:textColor="@color/cyber_dim_cyan"
                android:textSize="11sp"
                android:paddingTop="3dp" />

            <TextView
                android:id="@+id/esp32_packet_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Packets: 0 | Channel: --"
                android:textColor="@color/cyber_yellow"
                android:textSize="11sp"
                android:paddingTop="2dp" />

            <Button
                android:id="@+id/btn_connect_esp32"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="CONNECT ESP32 BLUETOOTH SPP"
                android:textColor="@color/cyber_cyan"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Pi / Kali Companion Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cyber_minimal_bg"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_device_car"
                    android:contentDescription="Pi / Kali" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="PI / KALI MONITOR STREAM"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pi_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE"
                    android:textColor="@color/cyber_pink"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Network stream from Kismet / airodump-ng / gpsd on companion Pi or Kali Linux rig."
                android:textColor="@color/cyber_dim_cyan"
                android:textSize="11sp"
                android:paddingTop="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <EditText
                    android:id="@+id/edit_pi_host"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="Host (192.168.4.1)"
                    android:textColor="@color/cyber_cyan"
                    android:textColorHint="@color/cyber_dim_cyan"
                    android:textSize="12sp"
                    android:background="@drawable/cyber_minimal_bg"
                    android:padding="8dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/edit_pi_port"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Port (2501)"
                    android:inputType="number"
                    android:textColor="@color/cyber_cyan"
                    android:textColorHint="@color/cyber_dim_cyan"
                    android:textSize="12sp"
                    android:background="@drawable/cyber_minimal_bg"
                    android:padding="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_connect_pi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="CONNECT PI / KALI COMPANION"
                android:textColor="@color/cyber_cyan"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- RTL-SDR Stream Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cyber_minimal_bg"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_device_tv"
                    android:contentDescription="SDR" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="RTL-SDR EXTRA-BAND STREAM"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sdr_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STANDBY"
                    android:textColor="@color/cyber_yellow"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connects to rtl_tcp daemon for extra ISM/sub-GHz monitoring (433MHz, 868MHz, 915MHz)."
                android:textColor="@color/cyber_dim_cyan"
                android:textSize="11sp"
                android:paddingTop="3dp" />

            <Button
                android:id="@+id/btn_connect_sdr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="CONNECT RTL-SDR (rtl_tcp:1234)"
                android:textColor="@color/cyber_cyan"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- GhostH Desktop Suite Sync Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cyber_minimal_bg"
            android:padding="10dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_device_car"
                    android:contentDescription="Desktop" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:text="GHOSTH DESKTOP SUITE (PC / LINUX)"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/desktop_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCONNECTED"
                    android:textColor="@color/cyber_pink"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bidirectional sync with Windows/Linux Desktop App. Stream NodeMCU data, sync observations, and trigger WiGLE API uploads."
                android:textColor="@color/cyber_dim_cyan"
                android:textSize="11sp"
                android:paddingTop="3dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <EditText
                    android:id="@+id/edit_desktop_host"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="Desktop IP (e.g. 192.168.1.50)"
                    android:textColor="@color/cyber_cyan"
                    android:textColorHint="@color/cyber_dim_cyan"
                    android:textSize="12sp"
                    android:background="@drawable/cyber_minimal_bg"
                    android:padding="8dp" />

                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />

                <EditText
                    android:id="@+id/edit_desktop_port"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Port (8889)"
                    android:inputType="number"
                    android:textColor="@color/cyber_cyan"
                    android:textColorHint="@color/cyber_dim_cyan"
                    android:textSize="12sp"
                    android:background="@drawable/cyber_minimal_bg"
                    android:padding="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_connect_desktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="CONNECT TO DESKTOP SUITE"
                android:textColor="@color/cyber_cyan"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_sync_desktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SYNC OBSERVATIONS TO DESKTOP"
                android:textColor="@color/cyber_yellow"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/btn_upload_wigle_desktop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="TRIGGER DESKTOP WIGLE API UPLOAD"
                android:textColor="@color/cyber_cyan"
                android:backgroundTint="#0C1425"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- Hardware Telemetry Log -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HARDWARE TELEMETRY LOG"
            android:textColor="@color/cyber_dim_cyan"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/hardware_telemetry_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="100dp"
            android:background="#05070E"
            android:padding="8dp"
            android:textColor="@color/cyber_cyan"
            android:textSize="11sp"
            android:text="// Hardware bus ready.\n// Plug in NodeMCU (USB-OTG) or connect to GhostH Wi-Fi AP." />
    </LinearLayout>
</ScrollView>
