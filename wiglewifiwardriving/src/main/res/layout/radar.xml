<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/cyber_bg"
    android:padding="6dp">

    <!-- Minimal HUD Header Counters (No borders) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/cyber_minimal_bg"
        android:paddingVertical="8dp"
        android:paddingHorizontal="4dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/radar_total_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/cyber_cyan"
            android:textSize="12sp"
            tools:text="TARGETS: 24" />

        <TextView
            android:id="@+id/radar_threat_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/cyber_pink"
            android:textSize="12sp"
            tools:text="FLOCK/ALPR: 2" />

        <TextView
            android:id="@+id/radar_iot_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/cyber_yellow"
            android:textSize="12sp"
            tools:text="IoT: 7" />

        <TextView
            android:id="@+id/radar_ble_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/cyber_green"
            android:textSize="12sp"
            tools:text="BLE: 5" />
    </LinearLayout>

    <!-- Tactical Intel Bar (Security Score & Best Channel) (Minimal, No borders) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/cyber_minimal_bg"
        android:paddingVertical="6dp"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/radar_security_score"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/cyber_green"
            android:textSize="11sp"
            tools:text="SEC SCORE: 92%" />

        <TextView
            android:id="@+id/radar_best_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyber_yellow"
            android:textSize="11sp"
            tools:text="BEST CH: 2.4G [6] | 5G [44]" />
    </LinearLayout>

    <!-- Radar Sweep View (Frameless) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="270dp"
        android:layout_gravity="center_horizontal"
        android:background="#05070E">

        <net.wigle.wigleandroid.ui.CyberRadarView
            android:id="@+id/cyber_radar_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Target Lock Card (Minimal, No borders) -->
    <LinearLayout
        android:id="@+id/target_lock_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/cyber_minimal_bg"
        android:layout_marginTop="6dp"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lock_target_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cyber_pink"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="[FLOCK / ALPR]" />

            <TextView
                android:id="@+id/lock_target_ssid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                android:textColor="@color/cyber_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="FS-CAM-0928" />

            <TextView
                android:id="@+id/lock_target_rssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cyber_green"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="-52 dBm" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp">

            <TextView
                android:id="@+id/lock_target_bssid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/cyber_dim_cyan"
                android:textSize="11sp"
                tools:text="MAC: 00:20:A6:12:34:56" />

            <TextView
                android:id="@+id/lock_target_freq"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cyber_yellow"
                android:textSize="11sp"
                tools:text="5180MHz (Ch 36)" />
        </LinearLayout>
    </LinearLayout>

    <!-- Detected Target List Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/cyber_cyan"
        android:textSize="11sp"
        android:textStyle="bold"
        android:text="TARGET TELEMETRY" />

    <!-- Target List (Minimal, no dividers) -->
    <ListView
        android:id="@+id/radar_target_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="2dp"
        android:background="@android:color/transparent" />
</LinearLayout>
