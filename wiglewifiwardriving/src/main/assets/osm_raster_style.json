{
  "version": 8,
  "name": "OpenStreetMap Raster",
  "sources": {
    "osm-raster-source": {
      "type": "raster",
      "tiles": [
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "\u00a9 OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "osm-raster-layer",
      "type": "raster",
      "source": "osm-raster-source",
      "minzoom": 0,
      "maxzoom": 19
    }
  ]
}
